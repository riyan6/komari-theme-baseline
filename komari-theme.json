{
  "name": "Komari Theme",
  "short": "komari-theme",
  "description": "Personal Komari theme (public status page).",
  "version": "1.0.2",
  "author": "riyan6",
  "url": "https://github.com/riyan6/komari-theme-baseline",
  "preview": "preview.webp",
  "configuration": {
    "type": "managed",
    "name": {
      "en": "Theme Settings",
      "zh-CN": "主题设置",
      "ja": "テーマ設定"
    },
    "data": [
      {
        "name": {
          "en": "General Settings",
          "zh-CN": "通用设置",
          "ja": "一般設定"
        },
        "type": "title"
      },
      {
        "key": "displayFont",
        "type": "select",
        "name": {
          "en": "Display Font Style",
          "zh-CN": "展示字体样式",
          "ja": "表示フォントスタイル"
        },
        "help": {
          "en": "Choose the font used for hero numbers, big metrics, and node titles.",
          "zh-CN": "选择用于主数字、大指标数值和节点大标题的展示字体。",
          "ja": "メイン数値、大きな指標、ノードタイトルに使用する表示フォントを選択します。"
        },
        "options": "Inter Tight,Geist,Space Grotesk",
        "default": "Space Grotesk"
      },
      {
        "key": "bodyFont",
        "type": "select",
        "name": {
          "en": "Body Font Style",
          "zh-CN": "正文字体样式",
          "ja": "本文フォントスタイル"
        },
        "help": {
          "en": "Choose the font used for tables, labels, key-value rows, chart axes, and buttons.",
          "zh-CN": "选择用于表格、标签、键值表、图表坐标轴和按钮的正文字体。",
          "ja": "テーブル、ラベル、キー値表、チャート軸、ボタンに使用する本文フォントを選択します。"
        },
        "options": "Inter Tight,Geist,Space Grotesk",
        "default": "Inter Tight"
      },
      {
        "key": "customFooterHtml",
        "type": "richtext",
        "name": {
          "en": "Custom Footer HTML",
          "zh-CN": "自定义页脚HTML",
          "ja": "カスタムフッターHTML"
        },
        "help": {
          "en": "Set custom HTML content for the footer to replace build and version information.",
          "zh-CN": "设置自定义页脚HTML内容以替代构建和版本信息。",
          "ja": "ビルドおよびバージョン情報を置き換えるカスタムフッターHTMLの内容を設定します。"
        },
        "default": ""
      }
    ]
  }
}
