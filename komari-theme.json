{
  "name": "Komari Theme",
  "short": "komari-theme",
  "description": "Komari Web UI Theme",
  "version": "1.0.0",
  "author": "Akizon77",
  "url": "https://github.com/komari-monitor/komari-web",
  "preview": "preview.webp",
  "configuration": {
    "type": "managed",
    "name": {
      "en": "Theme Settings",
      "zh-CN": "主题设置",
      "ja": "テーマ設定"
    },
    "data": [
      {
        "name": {
          "en": "General Settings",
          "zh-CN": "通用设置",
          "ja": "一般設定"
        },
        "type": "title"
      },
      {
        "key": "fontFamily",
        "type": "select",
        "name": {
          "en": "Font Style",
          "zh-CN": "字体样式",
          "ja": "フォントスタイル"
        },
        "help": {
          "en": "Choose the font used across the theme.",
          "zh-CN": "选择主题全局使用的字体。",
          "ja": "テーマ全体で使用するフォントを選択します。"
        },
        "options": "Inter Tight,Geist,Space Grotesk",
        "default": "Space Grotesk"
      },
      {
        "key": "customFooterHtml",
        "type": "richtext",
        "name": {
          "en": "Custom Footer HTML",
          "zh-CN": "自定义页脚HTML",
          "ja": "カスタムフッターHTML"
        },
        "help": {
          "en": "Set custom HTML content for the footer to replace build and version information.",
          "zh-CN": "设置自定义页脚HTML内容以替代构建和版本信息。",
          "ja": "ビルドおよびバージョン情報を置き換えるカスタムフッターHTMLの内容を設定します。"
        },
        "default": ""
      }
    ]
  }
}
